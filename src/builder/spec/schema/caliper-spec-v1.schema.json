{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:caliper:schema:spec:v1",
  "title": "Caliper spec, version 1, canonical JSON form",
  "description": "The structure, types, keys, enumerations, ranges, slots and options of a spec. References, cycles, layout placement, shapes and columns are checked by the spec library's validator, not by this schema. Version 1 is version 0 with the primitive scene, the control table, the GPU programs and stages, and the provenance table; a version 0 document with caliper_spec set to 1 is a valid version 1 document. See design/spec-format.md, design/instruments.md and design/gpu-programs.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["caliper_spec", "applet"],
  "properties": {
    "caliper_spec": { "const": 1 },
    "applet": { "$ref": "#/$defs/applet" },
    "source": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/source" } },
    "panel": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/panel" } },
    "layout": { "$ref": "#/$defs/layout_node" },
    "control": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/control" } },
    "program": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/program" } },
    "stage": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/stage" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "x": { "$ref": "#/$defs/extension" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "label": { "type": "string", "maxLength": 256 },
    "safe_integer": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "axis": { "type": "integer", "minimum": -8, "maximum": 7 },
    "range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "colormap": { "enum": ["viridis", "magma", "rdbu", "greys"] },
    "binding": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^[a-z][a-z0-9_-]{0,63}([.].+)?$"
    },
    "catalog_id": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(table|tensor|live|feed|metric|run):.+$"
    },
    "extension": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/extension_value" }
    },
    "extension_value": {
      "anyOf": [
        { "type": "string", "maxLength": 65536 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/extension_value" } },
        { "$ref": "#/$defs/extension" }
      ]
    },

    "applet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/title" },
        "description": { "type": "string", "maxLength": 4096 },
        "x": { "$ref": "#/$defs/extension" }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "catalog": { "$ref": "#/$defs/catalog_id" },
        "sql": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "from": { "$ref": "#/$defs/id" },
        "transform": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/transform" } },
        "x": { "$ref": "#/$defs/extension" }
      },
      "oneOf": [
        { "required": ["catalog"] },
        { "required": ["sql"] },
        { "required": ["from"] }
      ]
    },

    "transform": {
      "oneOf": [
        { "$ref": "#/$defs/transform_slice" },
        { "$ref": "#/$defs/transform_reduce" },
        { "$ref": "#/$defs/transform_normalise" }
      ]
    },
    "transform_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "axis"],
      "properties": {
        "op": { "const": "slice" },
        "axis": { "$ref": "#/$defs/axis" },
        "index": { "$ref": "#/$defs/safe_integer" },
        "start": { "$ref": "#/$defs/safe_integer" },
        "stop": { "$ref": "#/$defs/safe_integer" },
        "step": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "x": { "$ref": "#/$defs/extension" }
      },
      "if": { "required": ["index"] },
      "then": { "properties": { "start": false, "stop": false, "step": false } }
    },
    "transform_reduce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "axis", "fn"],
      "properties": {
        "op": { "const": "reduce" },
        "axis": {
          "anyOf": [
            { "$ref": "#/$defs/axis" },
            { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/axis" } }
          ]
        },
        "fn": { "enum": ["mean", "sum", "min", "max", "std", "var", "norm", "argmax", "argmin", "entropy"] },
        "keepdims": { "type": "boolean" },
        "x": { "$ref": "#/$defs/extension" }
      },
      "if": { "properties": { "fn": { "enum": ["argmax", "argmin"] } } },
      "then": {
        "properties": {
          "axis": { "anyOf": [ { "type": "integer" }, { "type": "array", "maxItems": 1 } ] }
        }
      }
    },
    "transform_normalise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "mode"],
      "properties": {
        "op": { "const": "normalise" },
        "mode": { "enum": ["minmax", "zscore", "softmax", "l2"] },
        "axis": { "$ref": "#/$defs/axis" },
        "x": { "$ref": "#/$defs/extension" }
      }
    },

    "panel": {
      "oneOf": [
        { "$ref": "#/$defs/panel_series" },
        { "$ref": "#/$defs/panel_heatmap" },
        { "$ref": "#/$defs/panel_points" },
        { "$ref": "#/$defs/panel_histogram" },
        { "$ref": "#/$defs/panel_table" },
        { "$ref": "#/$defs/panel_image" },
        { "$ref": "#/$defs/panel_text" },
        { "$ref": "#/$defs/panel_scene" }
      ]
    },
    "panel_series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "bind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "series" },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["y"],
          "properties": {
            "x": { "$ref": "#/$defs/binding" },
            "y": {
              "anyOf": [
                { "$ref": "#/$defs/binding" },
                { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/binding" } }
              ]
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x_label": { "$ref": "#/$defs/label" },
            "y_label": { "$ref": "#/$defs/label" },
            "x_range": { "$ref": "#/$defs/range" },
            "y_range": { "$ref": "#/$defs/range" },
            "x_log": { "type": "boolean" },
            "y_log": { "type": "boolean" },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "panel_heatmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "bind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "heatmap" },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": { "values": { "$ref": "#/$defs/binding" } }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x_label": { "$ref": "#/$defs/label" },
            "y_label": { "$ref": "#/$defs/label" },
            "colormap": { "$ref": "#/$defs/colormap" },
            "range": { "$ref": "#/$defs/range" },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "panel_points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "bind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "points" },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "$ref": "#/$defs/binding" },
            "y": { "$ref": "#/$defs/binding" },
            "z": { "$ref": "#/$defs/binding" },
            "positions": { "$ref": "#/$defs/binding" },
            "color": { "$ref": "#/$defs/binding" },
            "size": { "$ref": "#/$defs/binding" }
          },
          "oneOf": [
            { "required": ["x", "y"], "properties": { "positions": false } },
            { "required": ["positions"], "properties": { "x": false, "y": false, "z": false } }
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x_label": { "$ref": "#/$defs/label" },
            "y_label": { "$ref": "#/$defs/label" },
            "z_label": { "$ref": "#/$defs/label" },
            "colormap": { "$ref": "#/$defs/colormap" },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "panel_histogram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "bind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "histogram" },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": { "values": { "$ref": "#/$defs/binding" } }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x_label": { "$ref": "#/$defs/label" },
            "y_label": { "$ref": "#/$defs/label" },
            "bins": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "range": { "$ref": "#/$defs/range" },
            "y_log": { "type": "boolean" },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "panel_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "bind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "table" },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows"],
          "properties": { "rows": { "$ref": "#/$defs/id" } }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 255 }
            },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "panel_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "bind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "image" },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": { "values": { "$ref": "#/$defs/binding" } }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colormap": { "$ref": "#/$defs/colormap" },
            "range": { "$ref": "#/$defs/range" },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "panel_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "text" },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "value": { "$ref": "#/$defs/binding" } }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "maxLength": 16384 },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      },
      "anyOf": [
        { "required": ["bind"], "properties": { "bind": { "required": ["value"] } } },
        { "required": ["options"], "properties": { "options": { "required": ["text"] } } }
      ]
    },

    "live_scene": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^live:.+$"
    },
    "panel_scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "bind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "const": "scene" },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene"],
          "properties": { "scene": { "$ref": "#/$defs/live_scene" } }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "up": { "enum": ["+x", "-x", "+y", "-y", "+z", "-z"] },
            "view_camera": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 255 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "target": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                    "distance": { "type": "number", "minimum": 0 },
                    "azimuth": { "type": "number" },
                    "elevation": { "type": "number", "minimum": -89, "maximum": 89 }
                  }
                }
              ]
            },
            "include": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
            "exclude": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
            "labels": { "type": "boolean" },
            "axes": { "type": "boolean" },
            "scale_bar": { "type": "boolean" },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "bind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["slider", "button", "range", "toggle", "picker", "text"] },
        "title": { "$ref": "#/$defs/title" },
        "bind": {
          "type": "string",
          "maxLength": 320,
          "pattern": "^(param:[^\\u0000-\\u001f]{1,63}|action:[^\\u0000-\\u001f]{1,63}|run:pause|value|intervene:[^\\u0000-\\u001f]{1,255})$"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "minimum": 0 },
            "log": { "type": "boolean" },
            "value": { "type": "number" },
            "x": { "$ref": "#/$defs/extension" }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      },
      "if": { "properties": { "kind": { "const": "button" } } },
      "then": {
        "properties": {
          "bind": { "pattern": "^(action:.+|run:pause)$" },
          "options": { "properties": { "min": false, "max": false, "step": false, "log": false, "value": false } }
        }
      },
      "else": {
        "if": { "properties": { "kind": { "const": "slider" } } },
        "then": { "properties": { "bind": { "pattern": "^(param:.+|value)$" } } },
        "else": {
          "if": { "properties": { "kind": { "const": "toggle" } } },
          "then": {
            "properties": {
              "bind": { "pattern": "^(intervene:.+|param:.+)$" },
              "options": { "properties": { "min": false, "max": false, "step": false, "log": false, "value": false } }
            }
          }
        }
      }
    },
    "entity_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.-]{1,63}(/[A-Za-z0-9_.-]{1,63}){0,15}$"
    },
    "program_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["var", "source"],
      "properties": {
        "var": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$" },
        "source": { "type": "string", "minLength": 6, "maxLength": 68, "pattern": "^live:[^\\u0000-\\u001f]{1,63}$" }
      }
    },
    "program_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["geometry", "pixels"] },
        "panel": { "$ref": "#/$defs/id" },
        "entity": { "$ref": "#/$defs/entity_path" },
        "part": { "enum": ["points", "lines"] },
        "max_count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "arrays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["positions", "colors", "values", "radii"] }
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colormap": { "$ref": "#/$defs/colormap" },
            "vmin": { "type": "number" },
            "vmax": { "type": "number" }
          }
        },
        "width": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "format": { "enum": ["rgba8unorm"] }
      },
      "if": { "properties": { "kind": { "const": "geometry" } } },
      "then": {
        "required": ["panel", "max_count", "arrays"],
        "properties": { "width": false, "height": false, "format": false }
      },
      "else": {
        "required": ["width", "height"],
        "properties": { "panel": false, "entity": false, "part": false, "max_count": false, "arrays": false, "style": false }
      }
    },
    "program_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_ms": { "type": "number", "minimum": 0.01, "maximum": 50 },
        "memory_mb": { "type": "integer", "minimum": 1, "maximum": 512 },
        "every": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "wgsl", "inputs", "output"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "maxLength": 55 },
        "title": { "$ref": "#/$defs/title" },
        "wgsl": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "entry": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$" },
        "inputs": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/program_input" } },
        "output": { "$ref": "#/$defs/program_output" },
        "limits": { "$ref": "#/$defs/program_limits" },
        "workgroups": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel", "entity", "kind", "wgsl"],
      "properties": {
        "panel": { "$ref": "#/$defs/id" },
        "entity": { "$ref": "#/$defs/entity_path" },
        "kind": { "enum": ["material", "vertex"] },
        "wgsl": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreign"],
      "properties": {
        "foreign": { "type": "boolean" },
        "from": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "reviewed": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "sha256"],
            "properties": {
              "target": { "type": "string", "pattern": "^(program:[a-z][a-z0-9_-]{0,63}|stage:[^\\u0000-\\u001f]+/(material|vertex))$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "x": { "$ref": "#/$defs/extension" }
      }
    },
    "layout_node": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "$ref": "#/$defs/layout_split" },
        { "$ref": "#/$defs/layout_tabs" }
      ]
    },
    "layout_split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "children"],
      "properties": {
        "split": { "enum": ["horizontal", "vertical"] },
        "ratio": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
        "title": { "$ref": "#/$defs/title" },
        "children": { "type": "array", "minItems": 2, "maxItems": 64, "items": { "$ref": "#/$defs/layout_node" } },
        "x": { "$ref": "#/$defs/extension" }
      },
      "if": { "required": ["ratio"] },
      "then": { "properties": { "children": { "maxItems": 2 } } }
    },
    "layout_tabs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabs"],
      "properties": {
        "tabs": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/layout_node" } },
        "title": { "$ref": "#/$defs/title" },
        "x": { "$ref": "#/$defs/extension" }
      }
    }
  }
}
