# caliper_programs_text_source(<out_var>): writes a C++ source into the
# current binary folder that defines draw_prelude(), lib_modules() and
# lib_module() of caliper_builder/programs/pieces.h from draw_prelude.wgsl
# and the lib modules library/lib/<name>/<version>.wgsl, and sets <out_var>
# to its path. The builder's programs library and the browser module
# (web/wasm/CMakeLists.txt) both call it, so that the app, the script and the
# browser read one copy of each file (design/programmable-graphics.md,
# Prelude and Imports). A change of a file runs the configure step again.
set(CALIPER_PROGRAMS_TEXT_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(caliper_programs_text_source out_var)
    set(_dir "${CALIPER_PROGRAMS_TEXT_DIR}")
    file(GLOB _lib CONFIGURE_DEPENDS "${_dir}/library/lib/*/*.wgsl")
    list(SORT _lib)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_dir}/draw_prelude.wgsl")
    file(READ "${_dir}/draw_prelude.wgsl" _prelude)
    set(_entries "")
    foreach(_file IN LISTS _lib)
        get_filename_component(_version "${_file}" NAME_WE)
        get_filename_component(_module_dir "${_file}" DIRECTORY)
        get_filename_component(_module "${_module_dir}" NAME)
        file(READ "${_file}" _text)
        string(APPEND _entries "    {\"${_module}@${_version}\", R\"caliper_wgsl(${_text})caliper_wgsl\"},\n")
    endforeach()
    set(_out "${CMAKE_CURRENT_BINARY_DIR}/caliper_programs_text.cpp")
    set(_cpp "// Generated by programs_text.cmake from src/builder/programs/draw_prelude.wgsl and
// src/builder/programs/library/lib/; do not edit.
#include <caliper_builder/programs/pieces.h>

#include <utility>

namespace caliper_builder::programs {

namespace {
const std::pair<const char*, const char*> kLib[] = {
${_entries}    {nullptr, nullptr},
};
}  // namespace

std::string_view draw_prelude() {
    static constexpr char kText[] = R\"caliper_wgsl(${_prelude})caliper_wgsl\";
    return std::string_view(kText, sizeof kText - 1);
}

std::vector<std::string_view> lib_modules() {
    std::vector<std::string_view> out;
    for (const auto& m : kLib)
        if (m.first) out.emplace_back(m.first);
    return out;
}

std::string_view lib_module(std::string_view name_at_version) {
    for (const auto& m : kLib)
        if (m.first && name_at_version == m.first) return m.second;
    return std::string_view();
}

}  // namespace caliper_builder::programs
")
    file(WRITE "${_out}.tmp" "${_cpp}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_out}.tmp" "${_out}")
    file(REMOVE "${_out}.tmp")
    set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()
