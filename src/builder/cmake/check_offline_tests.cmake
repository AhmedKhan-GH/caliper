# The check of caliper_offline_check() (CaliperOfflineTests.cmake), run as
#   cmake -DCTEST=<ctest> -DBUILD_DIR=<build tree> -P check_offline_tests.cmake
# from a ctest entry that has no ENVIRONMENT of its own.

# 1. The switch reached this entry from ctest itself, so it reaches every entry.
if(NOT "$ENV{CALIPER_AGENT_OFFLINE}" STREQUAL "1")
    message(FATAL_ERROR "This test entry runs without CALIPER_AGENT_OFFLINE=1, so the entries that start the app or "
                        "caliper-agent do too: the tree's CMakeLists.txt must call caliper_offline_tests().")
endif()

# 2. No entry of the tree sets the variable otherwise, or changes it.
execute_process(COMMAND "${CTEST}" --show-only=json-v1 WORKING_DIRECTORY "${BUILD_DIR}"
                OUTPUT_VARIABLE json RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "ctest --show-only=json-v1 failed: ${err}")
endif()
if(CMAKE_VERSION VERSION_LESS 3.19)
    message(STATUS "The per-entry part of the check needs CMake 3.19; only the inherited switch was checked.")
    return()
endif()
string(JSON count LENGTH "${json}" tests)
set(bad "")
set(checked 0)
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON name GET "${json}" tests ${i} name)
        string(JSON props ERROR_VARIABLE no_props GET "${json}" tests ${i} properties)
        if(no_props)
            continue()
        endif()
        math(EXPR checked "${checked} + 1")
        string(JSON nprops LENGTH "${props}")
        if(nprops EQUAL 0)
            continue()
        endif()
        math(EXPR plast "${nprops} - 1")
        foreach(j RANGE ${plast})
            string(JSON pname GET "${props}" ${j} name)
            if(NOT pname STREQUAL "ENVIRONMENT" AND NOT pname STREQUAL "ENVIRONMENT_MODIFICATION")
                continue()
            endif()
            string(JSON values GET "${props}" ${j} value)
            string(JSON nvalues LENGTH "${props}" ${j} value)
            if(nvalues EQUAL 0)
                continue()
            endif()
            math(EXPR vlast "${nvalues} - 1")
            foreach(k RANGE ${vlast})
                string(JSON v GET "${props}" ${j} value ${k})
                if(v MATCHES "^CALIPER_AGENT_OFFLINE[=:]" AND NOT v STREQUAL "CALIPER_AGENT_OFFLINE=1")
                    list(APPEND bad "${name}: ${pname} ${v}")
                endif()
            endforeach()
        endforeach()
    endforeach()
endif()
if(bad)
    string(REPLACE ";" "\n  " bad "${bad}")
    message(FATAL_ERROR "These test entries set or change CALIPER_AGENT_OFFLINE:\n  ${bad}")
endif()
message(STATUS "CALIPER_AGENT_OFFLINE=1 reaches every one of the ${count} test entries; none changes it.")
