# The sidecar's offline switch for every test of a build tree
# (src/builder/agent/caliper_agent/offline.py, CALIPER_AGENT_OFFLINE=1): with
# it, caliper-agent never builds a client for a model server off loopback and
# refuses every connection off loopback, whatever started it: a test of the
# builder, the hidden app, a capture tool or a script.
#
#   caliper_offline_tests()
#       Writes a file that ctest includes with this directory's test file
#       (the directory property TEST_INCLUDE_FILES). The file sets the switch
#       in ctest's own environment, which every test process inherits, so an
#       entry has it without an ENVIRONMENT property of its own and cannot
#       forget it. Called by the host's top-level CMakeLists.txt and by
#       src/builder's, so that ctest run in either folder sets it.
#   caliper_offline_check(<name>)
#       A ctest entry, with no environment of its own, that fails when it does
#       not see CALIPER_AGENT_OFFLINE=1 (the switch did not reach it, so it
#       reaches no entry), and when any entry of the build tree sets the
#       variable to anything else or changes it (check_offline_tests.cmake).
#
# Works with CMake 3.18; the per-entry part of the check needs 3.19 (string(JSON)).

function(caliper_offline_tests)
    set(_file "${CMAKE_CURRENT_BINARY_DIR}/caliper_offline_tests.cmake")
    file(WRITE "${_file}"
         "# Generated by caliper_offline_tests() (src/builder/cmake/CaliperOfflineTests.cmake): every test\n"
         "# of this tree runs with the sidecar's offline switch, inherited from ctest's environment.\n"
         "set(ENV{CALIPER_AGENT_OFFLINE} 1)\n")
    set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${_file}")
endfunction()

function(caliper_offline_check name)
    add_test(NAME ${name}
             COMMAND ${CMAKE_COMMAND} "-DCTEST=${CMAKE_CTEST_COMMAND}" "-DBUILD_DIR=${CMAKE_BINARY_DIR}"
                     -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/check_offline_tests.cmake")
    set_tests_properties(${name} PROPERTIES LABELS "builder;offline" TIMEOUT 120)
endfunction()
