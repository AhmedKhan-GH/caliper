From 52f3747da7ce4a0c1156c83de2e3798936e6886c Mon Sep 17 00:00:00 2001
From: Ahmed Khan <emailahmedebadkhan@gmail.com>
Date: Sat, 23 May 2026 20:41:03 -0700
Subject: [PATCH 2/2] fix Qwen3.5/3.6 loading: rope sections, ssm_dt naming,
 per-layer KV heads, VLM partial load

- Allow shorter rope_dimension_sections arrays (3 elements instead of 4)
  by zero-padding in get_key_or_arr
- Fix ssm_dt tensor name: use plain name (no .bias suffix) matching GGUF
- Use per-layer n_head_kv/n_embd_k_gqa in tensor loading and graph
  building for hybrid recurrent/attention architectures
- Allow partial tensor loading when GGUF contains sibling vision or MTP
  tensors that the language model doesn't consume

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 src/llama-model-loader.cpp |  8 ++++++--
 src/llama-model.cpp        |  6 +++++-
 src/models/qwen35.cpp      | 20 +++++++++-----------
 src/models/qwen35moe.cpp   |  2 +-
 4 files changed, 21 insertions(+), 15 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index c645d0785..def826a3b 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -452,8 +452,12 @@ namespace GGUFMeta {
             struct GGUFMeta::ArrayInfo arr_info =
                 GGUFMeta::GKV<GGUFMeta::ArrayInfo>::get_kv(metadata, kid);
 
-            if (n != arr_info.length) {
-                throw std::runtime_error(format("key %s has wrong array length; expected %u, got %u", key.c_str(), n, (uint32_t) arr_info.length));
+            if (arr_info.length > n) {
+                throw std::runtime_error(format("key %s has wrong array length; expected <= %u, got %u", key.c_str(), n, (uint32_t) arr_info.length));
+            }
+
+            for (uint32_t i = (uint32_t)arr_info.length; i < n; i++) {
+                result[i] = T{};
             }
 
             return get_arr(key, result, required);
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index e1e960245..f3b9db919 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1407,7 +1407,11 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
             }
         }
     }
-    ml.done_getting_tensors();
+    {
+        bool has_siblings = ml.get_weight("v.patch_embed.weight") != nullptr
+                         || ml.get_weight("mtp.fc.weight") != nullptr;
+        ml.done_getting_tensors(has_siblings);
+    }
 
     GGML_ASSERT(!(output && tok_embd &&
             strcmp(output->name, tok_embd->name) == 0 &&
diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
